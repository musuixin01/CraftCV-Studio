# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local-only by default; public deployment requires an explicit network/security review.
HOST="127.0.0.1"
PORT="3000"
# CraftCV multi-model server configuration (use actual authorized model IDs).
# GEMINI_MODELS="gemini-3.8-flash"
# OPENAI_API_KEY=""
# OPENAI_MODELS="gpt-4.1-mini"
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODELS="deepseek-flash"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODELS="claude-sonnet-4-5"
# DASHSCOPE_API_KEY=""
# QWEN_MODELS="qwen-plus"
# ARK_API_KEY=""
# DOUBAO_MODELS="Your Ark model or endpoint ID"
# XAI_API_KEY=""
# GROK_MODELS="Your xAI model ID"
# OLLAMA_MODELS="qwen3:8b"
# Comma-separated model IDs are supported. Keep secrets server-side only.
